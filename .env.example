# Copie este archivo como .env y reemplace TODOS los valores.
# El archivo .env nunca debe subirse al repositorio.
# Use contraseñas largas y aleatorias (por ejemplo, 24+ caracteres).
# Genere una con:  python -c "import secrets; print(secrets.token_urlsafe(24))"

# --- Administrador de MongoDB (scripts de carga y mantenimiento) ---
MONGO_INITDB_ROOT_USERNAME=admin_coraleum
MONGO_INITDB_ROOT_PASSWORD=cambiar_por_una_clave_larga

# --- Usuario de la aplicación (lo usa la API; permisos solo sobre la BD) ---
MONGO_APP_USERNAME=coraleum_api
MONGO_APP_PASSWORD=cambiar_por_otra_clave_larga

MONGO_DATABASE=proyecto_noaa

# --- API ---
# Orígenes permitidos por CORS (separados por comas).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
# Documentación interactiva /docs. Déjela en false fuera de desarrollo.
ENABLE_DOCS=false

# --- Autenticación ---
# Clave para firmar las sesiones (mínimo 32 caracteres). Genere una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si la cambia, todas las sesiones abiertas se cierran.
JWT_SECRET=cambiar_por_una_clave_de_al_menos_32_caracteres
# Clave para CIFRAR los datos personales en MongoDB (correo, nombre, IP...).
# Debe ser DISTINTA de JWT_SECRET. Genérela una sola vez con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ¡NO la cambie ni la pierda! Sin ella los datos cifrados no se pueden leer.
# Guárdela también fuera del proyecto (gestor de contraseñas del equipo).
CLAVE_CIFRADO_DATOS=cambiar_por_otra_clave_de_al_menos_32_caracteres
# true SOLO cuando el sitio se publique con HTTPS. En localhost debe ser false.
COOKIE_SECURE=false
# Valores iniciales de la sesión (luego se cambian en Administración → Sesión).
# Límites: token 1-60 min, inactividad 1-60 min, duración máxima 1-24 h (NIST SP 800-63B-4, AAL2).
ACCESS_TOKEN_MINUTOS=15
SESION_INACTIVIDAD_MINUTOS=30
SESION_MAXIMA_HORAS=12
# Sesiones abiertas a la vez por usuario (1-5). Con 1, iniciar sesión en otro
# navegador cierra la sesión anterior.
SESIONES_SIMULTANEAS=1
