# Copie este archivo como .env y reemplace TODOS los valores.
# El archivo .env nunca debe subirse al repositorio.
# Use contraseñas largas y aleatorias (por ejemplo, 24+ caracteres).
# Genere una con:  python -c "import secrets; print(secrets.token_urlsafe(24))"

# --- Administrador de MongoDB (scripts de carga y mantenimiento) ---
MONGO_INITDB_ROOT_USERNAME=admin_coraleum
MONGO_INITDB_ROOT_PASSWORD=cambiar_por_una_clave_larga

# --- Usuario de la aplicación (lo usa la API; permisos solo sobre la BD) ---
MONGO_APP_USERNAME=coraleum_api
MONGO_APP_PASSWORD=cambiar_por_otra_clave_larga

MONGO_DATABASE=proyecto_noaa

# --- API ---
# Orígenes permitidos por CORS (separados por comas).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Documentación interactiva /docs. Déjela en false fuera de desarrollo.
ENABLE_DOCS=false
